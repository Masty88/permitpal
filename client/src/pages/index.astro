---
// src/pages/upload.astro
---

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.20.0/cdn/themes/light.css" />
    <script type="module" src="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.20.0/cdn/shoelace-autoloader.js"></script>
    <title>IFC Upload and Analysis</title>
</head>
<body>
    <div class="container">
        <h1>IFC Upload and Analysis</h1>
        <form id="uploadForm" class="upload-form">
            <div class="form-group">
                <label for="ifcFile">IFC File:</label>
                <input
                    type="file"
                    id="ifcFile"
                    accept=".ifc"
                    class="file-input"
                    required
                />
            </div>

            <div class="button-group">
                <button type="button" id="processButton" class="process-button">
                    Process IFC File
                </button>
            </div>
        </form>
        <div id="status" class="status"></div>
        <div id="results" class="results"></div>
        <div id="viewer" class="viewer-container"></div>
    </div>
</body>
</html>

<style>
    .container {
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem;
    }

    .upload-form {
        margin: 2rem 0;
    }

    .form-group {
        margin-bottom: 1rem;
    }

    .file-input {
        display: block;
        width: 100%;
        padding: 0.5rem;
        border: 1px solid #ccc;
        border-radius: 4px;
        margin-top: 0.5rem;
    }

    .process-button {
        padding: 1rem 1.5rem;
        background-color: #2196F3;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 1rem;
        transition: background-color 0.2s;
        width: 100%;
    }

    .process-button:hover {
        background-color: #1976D2;
    }

    .process-button:disabled {
        background-color: #cccccc;
        cursor: not-allowed;
    }

    .status {
        margin: 1rem 0;
        padding: 1rem;
        border-radius: 4px;
    }

    .status.error {
        background-color: #ffebee;
        color: #c62828;
    }

    .status.success {
        background-color: #e8f5e9;
        color: #2e7d32;
    }

    .status.processing {
        background-color: #e3f2fd;
        color: #1565c0;
    }

    .results {
        margin-top: 2rem;
        padding: 1rem;
        background-color: #f5f5f5;
        border-radius: 4px;
        white-space: pre-wrap;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
    }

    .viewer-container {
        width: 100%;
        height: 600px;
        background: #f5f5f5;
        margin-top: 2rem;
        border-radius: 4px;
        position: relative;
    }

    #renderer {
        width: 100%;
        height: 100%;
        position: absolute;
        left: 0;
        top: 0;
    }

</style>


<script>
    import {
        Viewer,
        DefaultViewerParams,
        SpeckleLoader,
        UrlHelper
    } from "@speckle/viewer";
    import { CameraController, SelectionExtension } from "@speckle/viewer";
    import { SpeckleSubscriptionManager } from '../SpeckleSubscriptionManager.js';


    const SPECKLE_SERVER = "https://app.speckle.systems";
    const SPECKLE_TOKEN = "e7a3b0340b976840e6c6c246b94f8cb83f4fc863df"
    const PYTHON_API = "http://127.0.0.1:8000";
    let viewer = null as any;
    let subscriptionManager = null;

async function initViewer() {
    const container = document.getElementById("viewer") as HTMLDivElement;
    const rendererDiv = document.createElement('div') as HTMLDivElement;
    rendererDiv.id = 'renderer';
    container.appendChild(rendererDiv);

    const params = DefaultViewerParams;
    params.showStats = true;
    params.verbose = true;

    viewer = new Viewer(rendererDiv, params);
    await viewer.init();

    viewer.createExtension(CameraController);
    viewer.createExtension(SelectionExtension);
    subscriptionManager = new SpeckleSubscriptionManager(
            SPECKLE_SERVER,
            SPECKLE_TOKEN,
            viewer
        );
}


async function setupAutoSync(streamId) {
    // Start subscription
    subscriptionManager.startSubscription(streamId);
}

async function loadSpeckleModel(streamId: any, objectId: any) {
    if (!viewer) {
        await initViewer();
    }

    const urls = await UrlHelper.getResourceUrls(
        `${SPECKLE_SERVER}/streams/${streamId}/objects/${objectId}`
    );

    for (const url of urls) {
        const loader = new SpeckleLoader(viewer.getWorldTree(), url, "");
        await viewer.loadObject(loader, true);
    }
}
    const processButton = document.getElementById('processButton');

    async function uploadToPython(file: string | Blob) {
        const formData = new FormData();
        formData.append('file', file);

        const response = await fetch(`${PYTHON_API}/upload`, {
            method: 'POST',
            body: formData
        });

        if (!response.ok) {
            throw new Error('Python API processing failed');
        }

        return await response.json();
    }

    async function uploadToSpeckle(file: string | Blob) {
        const formData = new FormData();
        formData.append('file', file);

        const response = await fetch(`${PYTHON_API}/upload-to-speckle`, {
            method: 'POST',
            body: formData
        });

        if (!response.ok) {
            throw new Error('Speckle upload failed');
        }

        return await response.json();
    }

    function updateStatus(message: string | null, type: string) {
        const statusDiv = document.getElementById('status');
        statusDiv.textContent = message;
        statusDiv.className = `status ${type}`;
    }

    function setFormEnabled(enabled: boolean) {
        const form = document.getElementById('uploadForm');
        const inputs = form.querySelectorAll('input, button');
        inputs.forEach(input => input.disabled = !enabled);
    }

    function displayResults(data: { pythonAnalysis: any; speckleUpload: any; }) {
        const resultsDiv = document.getElementById('results');
        resultsDiv.innerHTML = `
            <h2>Results</h2>
            <pre>${JSON.stringify(data, null, 2)}</pre>
        `;
    }

    async function handleUnifiedProcess() {
        const fileInput = document.getElementById('ifcFile');
        const file = fileInput.files[0];

        if (!file) {
            updateStatus('Please select an IFC file', 'error');
            return;
        }

        try {
            setFormEnabled(false);

            updateStatus('Analyzing IFC file...', 'processing');
            const pythonResult = await uploadToPython(file);

            updateStatus('Uploading to Speckle...', 'processing');
            const speckleResult = await uploadToSpeckle(file);

            const combinedResults = {
                pythonAnalysis: pythonResult,
                speckleUpload: speckleResult
            };

            displayResults(combinedResults);
            updateStatus('Processing complete! Loading viewer...', 'success');

            // Carica il modello nel viewer usando i dati dalla risposta di Speckle
            if (speckleResult?.data?.stream_id && speckleResult?.data?.object_id) {
                await loadSpeckleModel(
                    speckleResult.data.stream_id,
                    speckleResult.data.object_id
                );
                setupAutoSync(speckleResult.data.stream_id);
            }
        } catch (error) {
            console.error('Error:', error);
            updateStatus(`Error: ${error.message}`, 'error');
        } finally {
            setFormEnabled(true);
        }
    }

    await loadSpeckleModel(
                    "ac4a00b20e",
                    "0a2eb53ccf027b1cbf4243e1b5f5c09a"
                );
    setupAutoSync("ac4a00b20e");

    // Add event listener to the process button
    processButton?.addEventListener('click', handleUnifiedProcess);
</script>