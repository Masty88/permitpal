---
// src/pages/upload.astro
---
<script>
    import ObjectLoader from '@speckle/objectloader';
    </script>

    <html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>IFC Upload with Live Speckle Viewer</title>
    </head>
    <body>
        <div class="container">
            <h1>IFC Upload with Live Viewer</h1>
            <form id="uploadForm" class="upload-form">
                <div class="form-group">
                    <label for="ifcFile">IFC File:</label>
                    <input
                        type="file"
                        id="ifcFile"
                        accept=".ifc"
                        class="file-input"
                        required
                    />
                </div>

                <div class="button-group">
                    <button type="button" onclick="handleAnalyze()" class="analyze-button">
                        Analyze IFC
                    </button>
                    <button type="button"  id="speckle" class="speckle-button">
                        Upload to Speckle
                    </button>
                </div>
            </form>
            <div id="status" class="status"></div>
            <div id="results" class="results"></div>
            <div id="viewer" class="viewer-container"></div>
        </div>
    </body>

    <style>
        /* ... stili precedenti ... */

        .button-group {
            display: flex;
            gap: 1rem;
            margin-top: 1rem;
        }

        .analyze-button {
            padding: 1rem 1.5rem;
            background-color: #4CAF50;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 1rem;
            transition: background-color 0.2s;
        }

        .speckle-button {
            padding: 1rem 1.5rem;
            background-color: #2196F3;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 1rem;
            transition: background-color 0.2s;
        }

        .analyze-button:hover {
            background-color: #45a049;
        }

        .speckle-button:hover {
            background-color: #1976D2;
        }

        .button-group button:disabled {
            background-color: #cccccc;
            cursor: not-allowed;
        }
    </style>
    </html>

    <script>
        const PYTHON_API = "http://127.0.0.1:8000";
        const speckleBtn = document.getElementById('speckle');
        speckleBtn?.addEventListener('click', handleSpeckleUpload);

        async function uploadToPython(file) {
            const formData = new FormData();
            formData.append('file', file);

            const response = await fetch(`${PYTHON_API}/upload`, {
                method: 'POST',
                body: formData
            });

            if (!response.ok) {
                throw new Error('Python API processing failed');
            }

            return await response.json();
        }

        async function uploadToSpeckle(file) {
            const formData = new FormData();
            formData.append('file', file);

            const response = await fetch(`${PYTHON_API}/upload-to-speckle`, {
                method: 'POST',
                body: formData
            });

            if (!response.ok) {
                throw new Error('Speckle upload failed');
            }

            return await response.json();
        }

        function updateStatus(message, type) {
            const statusDiv = document.getElementById('status');
            statusDiv.textContent = message;
            statusDiv.className = `status ${type}`;
        }

        function setFormEnabled(enabled) {
            const form = document.getElementById('uploadForm');
            const inputs = form.querySelectorAll('input, button');
            inputs.forEach(input => input.disabled = !enabled);
        }

        function displayResults(data) {
            const resultsDiv = document.getElementById('results');
            resultsDiv.innerHTML = `
                <h2>Results</h2>
                <pre>${JSON.stringify(data, null, 2)}</pre>
            `;
        }

        async function handleAnalyze() {
            const fileInput = document.getElementById('ifcFile');
            const file = fileInput.files[0];

            if (!file) {
                updateStatus('Please select an IFC file', 'error');
                return;
            }

            try {
                setFormEnabled(false);
                updateStatus('Analyzing IFC...', 'processing');

                const response = await uploadToPython(file);
                displayResults(response);
                updateStatus('Analysis complete!', 'success');

            } catch (error) {
                console.error('Error:', error);
                updateStatus(`Error: ${error.message}`, 'error');
            } finally {
                setFormEnabled(true);
            }
        }

        async function handleSpeckleUpload() {
            const fileInput = document.getElementById('ifcFile');
            const file = fileInput.files[0];

            if (!file) {
                updateStatus('Please select an IFC file', 'error');
                return;
            }

            try {
                setFormEnabled(false);
                updateStatus('Uploading to Speckle...', 'processing');

                const response = await uploadToSpeckle(file);
                displayResults(response);
                updateStatus('Upload to Speckle complete!', 'success');

            } catch (error) {
                console.error('Error:', error);
                updateStatus(`Error: ${error.message}`, 'error');
            } finally {
                setFormEnabled(true);
            }
        }
    </script>